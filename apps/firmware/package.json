{
  "name": "@claudette/firmware",
  "version": "0.1.0",
  "private": true,
  "description": "Claudette ESP32-S3 firmware (PlatformIO + Arduino + LVGL)",
  "license": "MIT",
  "scripts": {
    "build": "pio run -e freenove-s3-4in",
    "build:stub": "pio run -e stub",
